<!DOCTYPE html>
<html lang="en-us">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <base href="https://cdn.jsdelivr.net/gh/wasmdotrip/Peak-Port@main/">
    <title>PEAK</title>
    <style>
      /* black, not the Unity brown: whatever the canvas does not cover reads as a
         letterbox bar rather than a strip of a different colour hanging off the bottom */
      html, body { margin: 0; padding: 0; background: #000; height: 100%;
                   overflow: hidden; }
      #wrap { display: flex; flex-direction: column; align-items: center;
              justify-content: center; height: 100%; background: #000; }
      #unity-canvas { background: #000; max-width: 100%; max-height: 100%;
                      outline: none; display: block; }
      #bar { width: 320px; height: 12px; margin-top: 14px; border: 1px solid #555;
             display: none; }
      #barfill { width: 0%; height: 100%; background: #7cc242; }
      #msg { color: #bbb; font: 13px/1.5 system-ui, sans-serif; margin-top: 10px;
             text-align: center; }
      #credit { position: fixed; right: 10px; bottom: 8px; z-index: 10;
                color: #8a8a8a; font: 12px/1.4 system-ui, sans-serif;
                text-align: right; pointer-events: auto; }
      #credit a { color: #7cc242; text-decoration: none; }
      #credit a:hover { text-decoration: underline; }
      #fs { position: fixed; left: 10px; bottom: 8px; z-index: 10; display: none;
            background: rgba(255,255,255,0.08); color: #ddd; border: 1px solid #555;
            border-radius: 4px; padding: 6px 12px; cursor: pointer;
            font: 12px/1 system-ui, sans-serif; }
      #fs:hover { background: rgba(255,255,255,0.18); }
    </style>
  </head>
  <body>
    <div id="wrap">
      <canvas id="unity-canvas" width="960" height="600" tabindex="-1"></canvas>
      <div id="bar"><div id="barfill"></div></div>
      <div id="msg">Loading…</div>
    </div>
    <button id="fs" type="button">Fullscreen</button>
    <div id="credit">
      ported by @._.dasher._.<br>
      <a href="https://wasm.rip/" target="_blank" rel="noopener">wasm.rip</a>
    </div>
    <script>
      // Manifest written by make_cdn_bundle.py. Each entry is either a plain file or a
      // list of parts that must be concatenated back together in order.
      var MANIFEST = {
  "data": {
    "file": "WebGL.data.unityweb",
    "parts": [
      "WebGL.data.unityweb.part000",
      "WebGL.data.unityweb.part001",
      "WebGL.data.unityweb.part002",
      "WebGL.data.unityweb.part003",
      "WebGL.data.unityweb.part004",
      "WebGL.data.unityweb.part005",
      "WebGL.data.unityweb.part006",
      "WebGL.data.unityweb.part007",
      "WebGL.data.unityweb.part008",
      "WebGL.data.unityweb.part009",
      "WebGL.data.unityweb.part010",
      "WebGL.data.unityweb.part011",
      "WebGL.data.unityweb.part012"
    ],
    "bytes": 241608952
  },
  "code": {
    "file": "WebGL.wasm.unityweb",
    "bytes": 12657365
  },
  "framework": {
    "file": "WebGL.framework.js.unityweb",
    "bytes": 85982
  },
  "loader": {
    "file": "WebGL.loader.js",
    "bytes": 117365
  }
};
      var BUILD = "Build";
      // Empty for a same-origin build. When set, <base> already redirects the fetches on
      // this page; this stamps the same root onto our own URL so the C# level streamer
      // (which resolves bundle URLs against Application.absoluteURL, ignoring <base>)
      // fetches LevelBundles from the CDN too instead of from wherever the page is hosted.
      var CDN_BASE = "https://cdn.jsdelivr.net/gh/wasmdotrip/Peak-Port@main";
      if (CDN_BASE) {
        var u = new URL(window.location.href);
        if (u.searchParams.get("cdn") !== CDN_BASE) {
          u.searchParams.set("cdn", CDN_BASE);
          history.replaceState(null, "", u.toString());
        }
      }

      var canvas  = document.querySelector("#unity-canvas");
      var bar     = document.querySelector("#bar");
      var barfill = document.querySelector("#barfill");
      var msg     = document.querySelector("#msg");

      function setMsg(t) { msg.textContent = t; }
      function mb(bytes) { return (bytes / 1048576).toFixed(1); }

      // Total download size, measured at package time — no HEAD requests needed, and it
      // stays correct even if the CDN omits Content-Length on a streamed response.
      var TOTAL = MANIFEST.data.bytes + MANIFEST.framework.bytes + MANIFEST.code.bytes;
      var downloaded = 0;

      function report(label) {
        bar.style.display = "block";
        var pct = TOTAL ? downloaded / TOTAL : 0;
        barfill.style.width = (pct * 100).toFixed(1) + "%";
        setMsg("Downloading " + label + "… " + mb(downloaded) + " / " + mb(TOTAL) +
               " MB (" + Math.floor(pct * 100) + "%)");
      }

      // Fetch every part and glue them into one Blob, then expose it as a blob: URL.
      // Unity's loader treats it like any other URL, so splitting stays invisible to it.
      // The body is read through a stream reader so the byte counter moves continuously
      // instead of jumping once per completed part.
      async function assemble(entry, label) {
        var urls = entry.parts || [entry.file];
        var buffers = [];
        for (var i = 0; i < urls.length; i++) {
          var url = BUILD + "/" + urls[i];
          var res = await fetch(url);
          if (!res.ok) throw new Error("failed to fetch " + url + " (" + res.status + ")");
          if (res.body && res.body.getReader) {
            var reader = res.body.getReader();
            while (true) {
              var step = await reader.read();
              if (step.done) break;
              buffers.push(step.value);
              downloaded += step.value.byteLength;
              report(label);
            }
          } else {
            // no streaming support: fall back to whole-part reads
            var buf = await res.arrayBuffer();
            buffers.push(buf);
            downloaded += buf.byteLength;
            report(label);
          }
        }
        return URL.createObjectURL(new Blob(buffers));
      }

      (async function () {
        try {
          var dataUrl      = await assemble(MANIFEST.data, "game data");
          var frameworkUrl = await assemble(MANIFEST.framework, "framework");
          var codeUrl      = await assemble(MANIFEST.code, "code");

          setMsg("Starting…");
          var script = document.createElement("script");
          script.src = BUILD + "/" + MANIFEST.loader.file;
          script.onload = function () {
            createUnityInstance(canvas, {
              dataUrl: dataUrl,
              frameworkUrl: frameworkUrl,
              codeUrl: codeUrl,
              streamingAssetsUrl: "StreamingAssets",
              companyName: "Aggro Crab & Landfall",
              productName: "PEAK",
              productVersion: "1.62.a",
            }, function (p) {
              bar.style.display = "block";
              barfill.style.width = Math.round(p * 100) + "%";
              setMsg("Loading… " + Math.round(p * 100) + "%");
            }).then(function (instance) {
              window.unityInstance = instance;
              bar.style.display = "none";
              setMsg("");
              // Unity's own SetFullscreen keeps the canvas sized to the screen; the
              // Fullscreen API on the element alone leaves the render target unchanged.
              var fs = document.querySelector("#fs");
              fs.style.display = "block";
              fs.onclick = function () {
                if (instance.SetFullscreen) instance.SetFullscreen(1);
                else if (canvas.requestFullscreen) canvas.requestFullscreen();
                canvas.focus();
              };
            }).catch(function (e) {
              setMsg("Failed to start: " + e);
            });
          };
          script.onerror = function () { setMsg("Failed to load " + script.src); };
          document.body.appendChild(script);
        } catch (e) {
          setMsg(String(e));
        }
      })();
    </script>
  </body>
</html>
